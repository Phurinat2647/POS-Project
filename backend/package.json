{
  "name": "food-pos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Food POS Management System - REST API (Express + MySQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:setup": "node scripts/db-setup.js",
    "db:check": "node scripts/db-check.js",
    "hash": "node scripts/hash-password.js",
