# ---------- Server ----------
NODE_ENV=development
PORT=5000
# URL ของ Frontend (ใช้กับ CORS และ Socket.IO) คั่นหลายค่าด้วย ,
CLIENT_URL=http://localhost:5173

# ---------- Database (MySQL / MariaDB) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_pos
DB_CONNECTION_LIMIT=10
# เขตเวลาที่ใช้บันทึก/คำนวณรายงาน (ประเทศไทย)
DB_TIMEZONE=+07:00

# ---------- Authentication ----------
# เปลี่ยนเป็นค่าสุ่มยาว ๆ ก่อนใช้งานจริง เช่น: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=10

# ---------- Upload ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
